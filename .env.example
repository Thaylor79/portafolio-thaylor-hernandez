# ============================================================
#  Copia este archivo, llámalo ".env" y llena tus datos.
#  El archivo .env NO se sube a GitHub (está en .gitignore).
# ============================================================

# --- Base de datos (MongoDB Atlas) ---
# Atlas → tu cluster → Connect → Drivers → copia la dirección.
# Cambia <password> por la contraseña del usuario de la base de datos
# y agrega el nombre de la base después de ".net/" (aquí: portafolio).
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/portafolio?retryWrites=true&w=majority

# --- Correo para los avisos (Gmail) ---
# EMAIL_USER: tu Gmail.
# EMAIL_PASS: una "contraseña de aplicación" de 16 letras (NO tu contraseña normal).
#             Se crea en https://myaccount.google.com/apppasswords (necesita verificación en 2 pasos).
# EMAIL_TO:   a dónde quieres que te lleguen los avisos (puede ser el mismo Gmail).
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=abcdabcdabcdabcd
EMAIL_TO=tucorreo@gmail.com

# --- Correo cuando el portafolio esté publicado en Render ---
# El plan gratis de Render bloquea Gmail (SMTP). Allá usa Resend (gratis):
# crea una cuenta en https://resend.com con el MISMO correo de EMAIL_TO,
# crea una API key y pégala aquí. Si está llena, se usa en vez de Gmail.
RESEND_API_KEY=

# --- Opcional ---
# Puerto local (por defecto 3000)
PORT=3000
# Dominios que pueden usar la API, separados por coma (* = todos).
# Ej: https://tu-usuario.github.io
ORIGENES_PERMITIDOS=*
